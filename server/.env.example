# ===== DeepSeek（必填）=====
# 在 https://platform.deepseek.com 注册并充值后获取
DEEPSEEK_API_KEY=sk-xxxx

# ===== LLM 模型（一般保持默认）=====
# 统一使用 deepseek-v4-flash（低成本高性能）。如需更强推理可单独换 reasoner：
#   LLM_REASONER_MODEL=deepseek-v4-pro （输出价约为 flash 的 3 倍）
LLM_CHAT_MODEL=deepseek-v4-flash
LLM_REASONER_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_BASE_DELAY_SECONDS=0.5

# ===== JWT（生产必须改成随机长字符串）=====
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE_DAYS=30

# ===== 数据 =====
# SQLite 数据库路径（容器内默认 /app/data/app.db，已挂载卷持久化）
DATABASE_PATH=./data/app.db
# 场景种子数据路径（首次启动自动导入；容器内默认 /app/seed/scenarios.json）
SCENARIOS_SEED_PATH=./data/scenarios.json

# ===== 邀请码 =====
# 首次启动若库为空，自动生成该数量的邀请码（可在日志查看，或用 gen_code 重新生成）
INVITE_CODE_COUNT=20

# ===== 开发期认证绕过 =====
# 1 = 开放 /auth/dev-login 免邀请码直登（仅本地调试用）；生产必须设为 0
AUTH_DEV_BYPASS=0

# ===== 语音（阶段3）=====
# ASR 模型（faster-whisper）：base / small / medium（越大越准、越慢、越占内存）
WHISPER_MODEL=base
# 说明：开发期 TTS 用 edge-tts（免费、无需密钥），ASR 用 faster-whisper（本地 CPU）。
#       生产环境可替换为火山引擎 TTS/ASR（需自行实现 services/tts.py、asr.py，路由契约不变）。
