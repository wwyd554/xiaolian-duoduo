# ============ DeepSeek (Anthropic 兼容端点) ============
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# 对话 + 实时评分模型
LLM_CHAT_MODEL=deepseek-chat
# 反馈报告 / 目标判断 / 记忆提取模型
LLM_REASONER_MODEL=deepseek-reasoner
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_BASE_DELAY_SECONDS=0.5

# ============ 应用 ============
# JWT 签名密钥（生产环境务必换成随机长字符串）
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE_DAYS=30
# SQLite 数据库文件路径（相对 server/）
DATABASE_PATH=./data/app.db
# 场景种子数据文件路径（相对 server/）
SCENARIOS_SEED_PATH=./data/scenarios.json
# 邀请码 CLI 默认生成数量
INVITE_CODE_COUNT=20
