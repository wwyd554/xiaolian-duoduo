# ===== DeepSeek（必填）=====
# 在 https://platform.deepseek.com 注册并充值后获取
DEEPSEEK_API_KEY=sk-xxxx

# ===== LLM 模型（复制到 .env 后按环境配置，代码不写死模型名）=====
# 开发期示例：统一 deepseek-v4-flash（低成本高性能）。如需更强推理可单独换：
#   LLM_REASONER_MODEL=deepseek-v4-pro （输出价约为 flash 的 3 倍）
LLM_CHAT_MODEL=deepseek-v4-flash
LLM_REASONER_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_BASE_DELAY_SECONDS=0.5
# 实时 NPC/评分/目标判断显式控制思考模式，避免小输出预算被耗尽；报告链路不受此项影响。
# disabled / enabled / inherit（沿用供应商默认行为）
LLM_REALTIME_THINKING=disabled
# 业务评分/导入复盘独立控制思考模式，默认优先生成完整 JSON，避免思考耗尽输出预算。
# disabled / enabled / inherit；inherit 使用供应商默认行为，不影响实时对话设置。
LLM_REVIEW_THINKING=disabled

# ===== JWT（生产必须改成随机长字符串）=====
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE_DAYS=30

# ===== 数据 =====
# SQLite 数据库路径（容器内默认 /app/data/app.db，已挂载卷持久化）
DATABASE_PATH=./data/app.db
# 场景种子数据路径（首次启动自动导入；容器内默认 /app/seed/scenarios.json）
SCENARIOS_SEED_PATH=./data/scenarios.json

# ===== 邀请码 =====
# 首次启动若库为空，自动生成该数量的邀请码（可在日志查看，或用 gen_code 重新生成）
INVITE_CODE_COUNT=20

# ===== 开发期认证绕过 =====
# 1 = 开放 /auth/dev-login 免邀请码直登（仅本地调试用）；生产必须设为 0
AUTH_DEV_BYPASS=0

# ===== 可恢复复盘与观测 =====
# 内嵌 Worker 默认开启。单独运行 python -m app.workers.jobs 时 API 可设置为 0。
JOB_WORKER_ENABLED=1
JOB_POLL_SECONDS=1
JOB_LEASE_SECONDS=30
JOB_TIMEOUT_SECONDS=900
JOB_MAX_ATTEMPTS=3
TRACE_DIR=./.trajectories
TRACE_RETENTION_DAYS=14

# ===== 会话状态 Runtime（0 回退固定工作流，状态与历史数据保留）=====
HARNESS_RUNTIME_ENABLED=1
# UTF-8 字节数作为保守 Token 上界估计，不是供应商精确 tokenizer。
CONTEXT_INPUT_BUDGET=16000
MAX_MESSAGE_CHARS=4000
# NPC 可选工具循环（0 仅关闭工具；完整回退用 HARNESS_RUNTIME_ENABLED=0）
HARNESS_TOOLS_ENABLED=1
# 默认走供应商原生 tools/tool_result；0 回退旧提示词 JSON 适配层。
HARNESS_NATIVE_TOOLS_ENABLED=1
# 单轮跨线程共享；每次供应商重试均扣次数/保守 Token 预留，不是人民币金额上限。
RUNTIME_MODEL_ATTEMPTS=12
RUNTIME_RESERVED_TOKENS=120000

# ===== 语音（阶段3）=====
# ASR 模型（faster-whisper）：base / small / medium（越大越准、越慢、越占内存）
WHISPER_MODEL=base
# 每用户每分钟连接/合成请求数；ASR、TTS 分别最多同机并发数（SQLite 共享）。
SPEECH_REQUESTS_PER_MINUTE=30
SPEECH_CONCURRENCY=4
# 说明：开发期 TTS 用 edge-tts（免费、无需密钥），ASR 用 faster-whisper（本地 CPU）。
#       生产环境可替换为火山引擎 TTS/ASR（需自行实现 services/tts.py、asr.py，路由契约不变）。
