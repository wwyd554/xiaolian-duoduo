# E2E 测试用环境变量设置文件
# 请复制此文件为 .env.test 并设置实际的值

# staging 环境 URL
E2E_BASE_URL=https://your-staging-environment.example.com

# 测试用 Cognito 账号
E2E_TEST_USER_EMAIL=test-user@example.com
E2E_TEST_USER_PASSWORD=your-test-password

# Cognito 设置（staging 环境使用）
E2E_COGNITO_USER_POOL_ID=us-west-2_xxxxxxxxx
E2E_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
